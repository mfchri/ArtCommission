# Supabase Configuration
# Ganti dengan Project URL dan Anon Key dari dashboard Supabase Anda (Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Formspree Endpoint (opsional, fallback jika Supabase tidak digunakan)
VITE_FORMSPREE_ENDPOINT=

# Email default artist
VITE_ARTIST_EMAIL=kaien.atelier@example.com
